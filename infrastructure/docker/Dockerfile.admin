FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages ./packages
COPY apps/admin-web ./apps/admin-web

RUN npm install
RUN npm run build --workspace=@yoobic/shared-types
RUN npm run build --workspace=@yoobic/validation
RUN npm run build --workspace=@yoobic/api-client
RUN npm run build --workspace=@yoobic/admin-web

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/admin-web/.next ./apps/admin-web/.next
COPY --from=builder /app/apps/admin-web/package*.json ./apps/admin-web/
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000
CMD ["npm", "run", "--workspace=@yoobic/admin-web", "start"]
