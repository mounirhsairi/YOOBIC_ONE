# =============================================================================
# YOOBIC ONE — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL is the primary / production dialect)
# -----------------------------------------------------------------------------
# Supported values: mysql | sqlite
# - mysql  → use with Docker Compose or a local MySQL 8 instance
# - sqlite → only for automated tests (NODE_ENV=test) or pure offline local work
DB_DIALECT=mysql

# MySQL connection (used when DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=yoobic
DB_PASSWORD=yoobic_secret
DB_NAME=yoobic_one

# Optional: SQLite file path when DB_DIALECT=sqlite and NODE_ENV != test
# SQLITE_STORAGE=./dev_database.sqlite

# -----------------------------------------------------------------------------
# JWT / Auth
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# -----------------------------------------------------------------------------
# Redis (optional for now — used later for sessions / queues)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (admin-web + Expo)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000

# Public URL of the API (used by admin-web and mobile)
NEXT_PUBLIC_API_URL=http://localhost:4000
